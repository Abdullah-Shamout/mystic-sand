# Mystic Sand environment (launch branch). Copy to `.env` and fill real values.
# `.env` is gitignored; this `.env.example` is committed as documentation.

# --- Database -----------------------------------------------------------------
# Postgres connection string. Dev value points at docker-compose.dev.yml (host port 5433).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://mystic:mystic@localhost:5433/mystic

# --- Object storage -----------------------------------------------------------
# Directory for admin-uploaded images (re-encoded server-side, served via /api/images/<id>).
# Defaults to ./uploads (gitignored) in dev. On a VPS this is a mounted Docker volume.
UPLOADS_DIR=./uploads

# --- Admin (seeded in Phase 4, argon2id) --------------------------------------
# First admin account. The seed CREATES this admin only when none exists yet — it never overwrites an
# existing (e.g. rotated) password. ADMIN_PASSWORD must meet the app's strong-password policy (>= 10
# chars with an uppercase letter, a number and a symbol) or the seed refuses to run. Left blank here so
# an unedited copy seeds no admin; set a strong value before seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Runtime ------------------------------------------------------------------
# App environment: development | test | staging | production.
# Gates the payment sandbox (the app refuses to boot the sandbox in production).
APP_ENV=development

# --- Payments -----------------------------------------------------------------
# Which payment adapter to load: sandbox | myfatoorah | tap | upayments | ...
PAYMENT_PROVIDER=sandbox

# Must be true (and APP_ENV must not be production) for the sandbox adapter to boot.
PAYMENT_SANDBOX_OK=true

# --- Auth ---------------------------------------------------------------------
# Secret used to sign the session-id cookie (jose). Must be a long, high-entropy random string of at
# least 32 characters; generate a fresh one PER environment (e.g. `openssl rand -base64 48`). This
# placeholder is < 32 chars on purpose, so an unedited copy FAILS CLOSED instead of booting with a
# known key.
SESSION_SECRET=CHANGE_ME

# Name of the request header your reverse proxy sets to the REAL client IP, used for the login rate-
# limit key: "cf-connecting-ip" behind Cloudflare, or "x-real-ip" if the proxy OVERWRITES it. Leave
# unset in dev (no proxy). The inbound X-Forwarded-For is never trusted directly — its leftmost hop is
# client-controlled; without this set the code falls back to the rightmost XFF hop only to bucket
# attempts. Pair with the reverse-proxy request-rate cap (Phase 9) for the real per-source limit.
# TRUSTED_IP_HEADER=cf-connecting-ip
